+    def test_calibration_repeated_evidence_is_idempotent(self):
+        from selfopt_chain.calibrate import fit_temperatures
+        decisions = [{"id": "d1", "question_type": "strategy", "deferred": False, "confidence": 0.6, "chosen": "x", "final": "x"}]
