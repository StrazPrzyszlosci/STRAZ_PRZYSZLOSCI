{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strazprzyszlosci.example/schemas/execution-pack-skill-v1.json",
  "title": "ExecutionPackSkill",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "goal",
    "mission_alignment",
    "allowed_modes",
    "inputs",
    "outputs",
    "audit_trail",
    "review_gates",
    "safety_notes",
    "next_handoff"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "goal": { "type": "string", "minLength": 20 },
    "mission_alignment": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["food", "waste", "water", "energy", "hardware_reuse", "social_coordination", "knowledge", "safety", "auditability"] }
    },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["read-only", "suggest-only", "dry-run", "staging-write", "hardware-lab", "production"] }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "required"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["repo_file", "external_repo", "sensor_data", "photo", "operator_note", "catalog", "api", "handoff"] },
          "required": { "type": "boolean" },
          "provenance_required": { "type": "boolean", "default": true }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path_or_type", "description", "review_required"],
        "properties": {
          "path_or_type": { "type": "string" },
          "description": { "type": "string" },
          "review_required": { "type": "boolean" }
        }
      }
    },
    "audit_trail": {
      "type": "object",
      "required": ["must_record_inputs", "must_record_tool_versions", "must_record_decisions", "must_record_artifacts"],
      "properties": {
        "must_record_inputs": { "type": "boolean" },
        "must_record_tool_versions": { "type": "boolean" },
        "must_record_decisions": { "type": "boolean" },
        "must_record_artifacts": { "type": "boolean" }
      }
    },
    "review_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "reviewer_role", "blocks"],
        "properties": {
          "gate": { "type": "string" },
          "reviewer_role": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "safety_notes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "next_handoff": { "type": "string", "minLength": 10 }
  }
}
