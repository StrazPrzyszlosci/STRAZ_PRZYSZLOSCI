{
  "cells": [
    {
      "cell_id": "edge_flasher",
      "version": "v1",
      "status": "active",
      "purpose": "Scaffold suggest-only for edge devices: generate device_profile, install_receipt, bench_test_report, rollback. No firmware flashing, no port opening, no install.",
      "allowed_modes": [
        "read-only",
        "suggest-only",
        "dry-run"
      ],
      "input_contract": [
        {
          "name": "profile_id",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "profiles.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        }
      ],
      "output_artifacts": [
        {
          "path_or_type": "device_profile.json",
          "description": "Deterministic profile per cell",
          "review_required": true
        },
        {
          "path_or_type": "install_receipt.json",
          "description": "Receipt starts NOT_INSTALLED + MISSING_HUMAN_APPROVAL",
          "review_required": true
        },
        {
          "path_or_type": "bench_test_report.md",
          "description": "Bench report starts BLOCKED_PENDING_REAL_BENCH_AND_HUMAN_APPROVAL",
          "review_required": true
        },
        {
          "path_or_type": "rollback.md",
          "description": "Rollback plan per profile",
          "review_required": true
        }
      ],
      "model_resource_policy": {
        "default_profile": "selfhost_recovered_low_power_node",
        "fallback_profile": "free_public_small_model",
        "may_use_paid": false,
        "may_use_private_data_on_public_model": false,
        "energy_justification_required": false
      },
      "energy_policy": {
        "default_class": "owned_hardware_low_cost",
        "low_power_first": true,
        "oze_preferred": true
      },
      "human_control_points": [
        {
          "point": "physical_installation",
          "reviewer_role": "operator",
          "blocks": [
            "install",
            "write_storage"
          ]
        },
        {
          "point": "network_exposure",
          "reviewer_role": "operator",
          "blocks": [
            "open_inbound_ports"
          ]
        },
        {
          "point": "actuation",
          "reviewer_role": "operator",
          "blocks": [
            "physical_actuation"
          ]
        }
      ],
      "audit_trail": {
        "must_record_inputs": true,
        "must_record_tool_versions": true,
        "must_record_decisions": true,
        "must_record_artifacts": true
      },
      "rollback_plan": {
        "strategy": "Receipt NOT_INSTALLED + rollback.md per profile; never auto-install.",
        "rollback_artifact": "rollback.md"
      },
      "review_gates": [
        {
          "gate": "no_physical_installation_without_human_approval",
          "reviewer_role": "operator",
          "blocks": [
            "physical_installation",
            "firmware_change"
          ]
        },
        {
          "gate": "no_network_exposure_without_operator",
          "reviewer_role": "operator",
          "blocks": [
            "open_inbound_ports",
            "internet_exposure"
          ]
        }
      ],
      "safety_notes": [
        "Generator generates artifacts only; physical installation is operator-only.",
        "blocked_high_risk_actions are listed per profile."
      ],
      "implementation_ref": {
        "directory": "edge_flasher",
        "entry_artifact": "edge_flasher/generate_artifacts.py"
      }
    },
    {
      "cell_id": "resource_scout",
      "version": "v1",
      "status": "active",
      "purpose": "Normalize signals about free or low-cost resources (e-waste, self-host compute) into validated records with location, cost, risks, evidence.",
      "allowed_modes": [
        "read-only",
        "suggest-only",
        "staging-write"
      ],
      "input_contract": [
        {
          "name": "resource_record_json",
          "kind": "operator_note",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "examples",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        }
      ],
      "output_artifacts": [
        {
          "path_or_type": "validated_record.json",
          "description": "Record with provenance, location, cost, risks, evidence",
          "review_required": true
        }
      ],
      "model_resource_policy": {
        "default_profile": "free_public_small_model",
        "fallback_profile": "selfhost_recovered_low_power_node",
        "may_use_paid": false,
        "may_use_private_data_on_public_model": false,
        "energy_justification_required": false
      },
      "energy_policy": {
        "default_class": "external_provider",
        "low_power_first": true,
        "oze_preferred": false
      },
      "human_control_points": [
        {
          "point": "record_review",
          "reviewer_role": "maintainer",
          "blocks": [
            "publish_without_review"
          ]
        }
      ],
      "audit_trail": {
        "must_record_inputs": true,
        "must_record_tool_versions": true,
        "must_record_decisions": true,
        "must_record_artifacts": true
      },
      "rollback_plan": {
        "strategy": "Records are drafts; deletion is manual via repo history.",
        "rollback_artifact": "git_history"
      },
      "review_gates": [
        {
          "gate": "no_publish_without_review",
          "reviewer_role": "maintainer",
          "blocks": [
            "publish_without_review"
          ]
        }
      ],
      "safety_notes": [
        "Validator blocks record without cost, location, or risks.",
        "No private data in public model."
      ],
      "implementation_ref": {
        "directory": "resource_scout",
        "entry_artifact": "resource_scout/validate_records.py"
      }
    },
    {
      "cell_id": "model_resource_selector",
      "version": "v1",
      "status": "active",
      "purpose": "Pick AI/resource profile by cost+privacy+energy: free public small model for public tasks, self-host low power for private, GPU only with energy justification.",
      "allowed_modes": [
        "read-only",
        "suggest-only"
      ],
      "input_contract": [
        {
          "name": "task_kind",
          "kind": "operator_note",
          "required": true,
          "provenance_required": false
        },
        {
          "name": "profiles.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        }
      ],
      "output_artifacts": [
        {
          "path_or_type": "selection.json",
          "description": "Selected profile + reason",
          "review_required": true
        }
      ],
      "model_resource_policy": {
        "default_profile": "free_public_small_model",
        "fallback_profile": "selfhost_recovered_low_power_node",
        "may_use_paid": false,
        "may_use_private_data_on_public_model": false,
        "energy_justification_required": true
      },
      "energy_policy": {
        "default_class": "low_power_or_oze_preferred",
        "low_power_first": true,
        "oze_preferred": true
      },
      "human_control_points": [
        {
          "point": "energy_justification_for_gpu",
          "reviewer_role": "operator",
          "blocks": [
            "selfhost_gpu_high_cost_node"
          ]
        }
      ],
      "audit_trail": {
        "must_record_inputs": true,
        "must_record_tool_versions": true,
        "must_record_decisions": true,
        "must_record_artifacts": true
      },
      "rollback_plan": {
        "strategy": "Re-run selector with energy justification off.",
        "rollback_artifact": "selection.json"
      },
      "review_gates": [
        {
          "gate": "no_gpu_without_energy_justification",
          "reviewer_role": "operator",
          "blocks": [
            "selfhost_gpu_high_cost_node"
          ]
        },
        {
          "gate": "no_private_data_on_public_model",
          "reviewer_role": "maintainer",
          "blocks": [
            "public_model_with_private_data"
          ]
        }
      ],
      "safety_notes": [
        "Private tasks must NOT be pushed to public model by simple consent flag.",
        "GPU runtime needs explicit energy justification."
      ],
      "implementation_ref": {
        "directory": "model_resource_selector",
        "entry_artifact": "model_resource_selector/select_model.py"
      }
    },
    {
      "cell_id": "potential_pipeline",
      "version": "v1",
      "status": "active",
      "purpose": "Model potential->idea->project->execution->optimization loop, validate order, generate Markdown plan, no deployment, no hardware control.",
      "allowed_modes": [
        "read-only",
        "suggest-only",
        "dry-run"
      ],
      "input_contract": [
        {
          "name": "seed_dossiers.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "potential_schema.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        }
      ],
      "output_artifacts": [
        {
          "path_or_type": "execution_plan.md",
          "description": "Markdown plan without deployment or hardware control",
          "review_required": true
        }
      ],
      "model_resource_policy": {
        "default_profile": "free_public_small_model",
        "fallback_profile": "selfhost_recovered_low_power_node",
        "may_use_paid": false,
        "may_use_private_data_on_public_model": false,
        "energy_justification_required": false
      },
      "energy_policy": {
        "default_class": "external_provider",
        "low_power_first": true,
        "oze_preferred": false
      },
      "human_control_points": [
        {
          "point": "approval_for_physical_products",
          "reviewer_role": "maintainer",
          "blocks": [
            "approve_physical_product_without_human_review"
          ]
        }
      ],
      "audit_trail": {
        "must_record_inputs": true,
        "must_record_tool_versions": true,
        "must_record_decisions": true,
        "must_record_artifacts": true
      },
      "rollback_plan": {
        "strategy": "Plan is Markdown draft; regenerate after dossier fix.",
        "rollback_artifact": "execution_plan.md"
      },
      "review_gates": [
        {
          "gate": "approval_required_for_physical_products",
          "reviewer_role": "maintainer",
          "blocks": [
            "physical_actuation",
            "production"
          ]
        }
      ],
      "safety_notes": [
        "Seed potential must be free or low-cost.",
        "No deployment, no hardware control."
      ],
      "implementation_ref": {
        "directory": "potential_pipeline",
        "entry_artifact": "potential_pipeline/generate_execution_plan.py"
      }
    },
    {
      "cell_id": "aquaponics_observer_pack",
      "version": "v1",
      "status": "draft",
      "purpose": "Execution pack for phone-aquaponics-observer: observation + report only, no pump/dosing/heater/feeding/valve actuation. Uses edge_flasher artifacts as input.",
      "allowed_modes": [
        "read-only",
        "suggest-only",
        "human-approved"
      ],
      "input_contract": [
        {
          "name": "edge_flasher device_profile.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "edge_flasher install_receipt.json",
          "kind": "repo_file",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "manual water measurements",
          "kind": "operator_note",
          "required": true,
          "provenance_required": true
        },
        {
          "name": "operator observation note",
          "kind": "operator_note",
          "required": true,
          "provenance_required": true
        }
      ],
      "output_artifacts": [
        {
          "path_or_type": "aquaponics_observation_report.md",
          "description": "Observation report only",
          "review_required": true
        },
        {
          "path_or_type": "operator_questions.md",
          "description": "Questions for human operator",
          "review_required": true
        },
        {
          "path_or_type": "run_receipt.json",
          "description": "Run receipt without actuation",
          "review_required": true
        }
      ],
      "model_resource_policy": {
        "default_profile": "free_public_small_model",
        "fallback_profile": "selfhost_recovered_low_power_node",
        "may_use_paid": false,
        "may_use_private_data_on_public_model": false,
        "energy_justification_required": false
      },
      "energy_policy": {
        "default_class": "low_power_or_oze_preferred",
        "low_power_first": true,
        "oze_preferred": true
      },
      "human_control_points": [
        {
          "point": "human_operator_before_biology_change",
          "reviewer_role": "operator",
          "blocks": [
            "any_biology_change",
            "actuation"
          ]
        }
      ],
      "audit_trail": {
        "must_record_inputs": true,
        "must_record_tool_versions": true,
        "must_record_decisions": true,
        "must_record_artifacts": true
      },
      "rollback_plan": {
        "strategy": "Pack is observation only; rollback means operator takes phone offline.",
        "rollback_artifact": "run_receipt.json"
      },
      "review_gates": [
        {
          "gate": "human_operator_before_biology_change",
          "reviewer_role": "operator",
          "blocks": [
            "actuation",
            "biology_change"
          ]
        },
        {
          "gate": "food_safety_review_before_recommendation",
          "reviewer_role": "food_safety_reviewer",
          "blocks": [
            "recommendation"
          ]
        },
        {
          "gate": "no_physical_actuation_without_human_approval",
          "reviewer_role": "operator",
          "blocks": [
            "physical_actuation",
            "pump_actuation",
            "dosing",
            "heater_actuation",
            "feeding",
            "valve_actuation"
          ]
        }
      ],
      "safety_notes": [
        "Pack uses edge_flasher artifacts as read-only input.",
        "No pump/dosing/heater/feeding/valve actuation allowed."
      ],
      "implementation_ref": {
        "directory": "PROJEKTY/13_baza_czesci_recykling/execution_packs/pack-phone-aquaponics-observer-01",
        "entry_artifact": "PROJEKTY/13_baza_czesci_recykling/execution_packs/pack-phone-aquaponics-observer-01/manifest.json",
        "pack_id": "pack-phone-aquaponics-observer-01"
      }
    }
  ]
}
