      },
      "rollback_plan": {
        "strategy": "Jobs are staged (next_disabled=true); maintainer deletes queue or removes job before execution.",
        "rollback_artifact": "seed_queue.json"
      },
      "review_gates": [
        {
          "gate": "no_auto_merge_by_hermes",
          "reviewer_role": "maintainer",
          "blocks": [
            "auto_merge"
          ]
        },
        {
          "gate": "no_direct_push_by_hermes",
          "reviewer_role": "maintainer",
          "blocks": [
            "direct_push_main"
          ]
        },
        {
          "gate": "human_before_data_write",
          "reviewer_role": "maintainer",
          "blocks": [
            "staging-write_without_review"
          ]
        }
      ],
      "safety_notes": [
        "Every job has no_auto_merge=true and no_direct_push=true.",
        "next_disabled=true prevents auto-chaining.",
        "Queue is manual; operator triggers jobs one at a time."
      ],
      "implementation_ref": {
        "directory": "hermes_work_queue",
        "entry_artifact": "hermes_work_queue/validate_queue.py"
      }
    },
