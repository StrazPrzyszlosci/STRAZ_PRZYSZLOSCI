{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strazprzyszlosci.example/schemas/human-approval-record-v1.json",
  "title": "HumanApprovalRecord",
  "description": "Rekord zatwierdzenia przez czlowieka: kto, co, zakres, czas, ryzyka, expiry, rollback. Approval wygasa. Approval dla kodu nie zatwierdza fizycznego dzialania. Approval dla providerow nie zatwierdza zwiekszania kosztow bez ledgeru.",
  "type": "object",
  "required": [
    "id",
    "approved_by",
    "approved_scope",
    "artifacts_or_target",
    "granted_at",
    "expires_at",
    "risks",
    "rollback_command",
    "human_control_point",
    "revoked",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "approved_by": {
      "type": "object",
      "required": [
        "role",
        "label"
      ],
      "properties": {
        "role": {
          "enum": [
            "operator",
            "maintainer",
            "volunteer"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approved_scope": {
      "type": "string",
      "enum": [
        "code_review",
        "physical_installation",
        "provider_cost_increase",
        "production_deploy",
        "dry_run_only"
      ]
    },
    "artifacts_or_target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "granted_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback_command": {
      "type": "string",
      "minLength": 2
    },
    "human_control_point": {
      "type": "string",
      "minLength": 5
    },
    "revoked": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 10
    },
    "cost_ledger_ref": {
      "type": "string"
    }
  }
}
